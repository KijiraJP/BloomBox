# Copy these values into backend/.env. Never commit the real .env file.
DB_HOST=localhost
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=bloombox
DB_PORT=3306
JWT_SECRET=replace_with_a_strong_secret

# Create the key in Google AI Studio. Keep it on the backend only.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
# Official SDK quickstart model alias. Change only after checking your AI Studio availability/quota.
GEMINI_MODEL=gemini-flash-latest
