#db host makikita yan sa schema file ya
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=bloombox
DB_PORT=3306

# generate nyo lng sa powershell sabay lagay jan sa jwt
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# makukuha sa google cloud console
GOOGLE_CLIENT_ID=

# Ung susi lagay dito (hingi kau sakin)
XENDIT_SECRET_KEY=

# Webhook callback token (Xendit dashboard > Settings > Webhooks). Optional;
# only needed once the webhook route is reachable from the public internet.
XENDIT_WEBHOOK_TOKEN=
