# Backend environment variables.
# Copy this file to ".env" (backend/.env) and fill in real values.
# The real .env is gitignored and must never be committed.

# Database (XAMPP MySQL defaults shown)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=bloombox
DB_PORT=3306

# Auth - use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Google OAuth - must be a real client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

# Xendit - use the sandbox/test secret key (starts with xnd_development_)
XENDIT_SECRET_KEY=
